{
  "name": "icecold-v3",
  "version": "0.1.0",
  "private": true,
  "description": "ICE COLD v3: air-gapped XRPL signer (offline) and transaction builder (online)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 test/unit/ test/e2e/",
    "test:unit": "node --test test/unit/",
    "test:e2e": "npm run build && node --test test/e2e/"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "ripple-address-codec": "5.0.1",
    "ripple-binary-codec": "2.11.0",
    "ripple-keypairs": "3.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "xrpl": "5.3.0"
  }
}
